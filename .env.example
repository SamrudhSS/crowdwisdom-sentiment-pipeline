# Copy to .env and fill in. Never commit the real .env file.

# Apify (https://apify.com/)
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Actor used for X/Twitter scraping: apidojo/tweet-scraper ("Tweet Scraper").
# Billing: $0.40 per 1,000 tweets. Each query must return >= 50 tweets, so
# very narrow cashtag/keyword queries on low-volume tickers can fail the
# minimum -- broaden the search terms or switch to the same vendor's
# "Twitter Scraper Unlimited" actor (event-based pricing, no 50-tweet floor)
# if that happens.
APIFY_X_ACTOR_ID=apidojo/tweet-scraper

# Tavily (https://tavily.com/)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Exa (https://exa.ai/) as a secondary/backup news search
EXA_API_KEY=

# Price data
PRICE_PROVIDER=yfinance
